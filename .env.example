# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Taplink

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=dev-secret-change-in-production-32chars

# ── Database ──────────────────────────────────────────────────────────────────
# Default for Docker Compose stack:
MONGODB_URI=mongodb://mongodb:27017/taplink?replicaSet=rs0&directConnection=true
MONGODB_REPLICA_SET=rs0
# If running app outside Docker while MongoDB runs in Docker:
# MONGODB_URI=mongodb://127.0.0.1:27017/taplink?directConnection=true

# ── Email (SMTP via Mailpit) ──────────────────────────────────────────────────
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
EMAIL_FROM=noreply@taplink.local

# ── Features ──────────────────────────────────────────────────────────────────
REQUIRE_EMAIL_VERIFICATION=false
